{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": ["config:recommended", ":enablePreCommit", "helpers:pinGitHubActionDigests"],

  // Run about bi-weekly.
  "schedule": ["* * 3,22 * *"],
  "timezone": "Etc/UTC",
  "prConcurrentLimit": 10,

  "labels": ["dependencies"],

  "dependencyDashboard": false,

  "minimumReleaseAge": "7 days",

  // Periodically refresh lockfiles to catch transitive dependency updates.
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },

  "packageRules": [
    // Auto-merge GitHub Actions updates.
    {
      "matchCategories": ["ci"],
      "automerge": true,
      "groupName": "CI configuration dependencies"
    },

    // Auto-merge npm package updates.
    {
      "matchManagers": ["npm"],
      "automerge": true
    },

    // The site depends on the current Astro major; major upgrades need manual work.
    {
      "matchManagers": ["npm"],
      "matchDepNames": ["astro"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ]
}

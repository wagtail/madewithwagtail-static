---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Submit your site">
  <div class="content-width">
    <div class="banner">
      <h1>Submit your site</h1>
    </div>
    <div class="intro">
      <p>Want to add your Wagtail-powered site to the showcase?</p>
      <p>
        Fill in the{' '}
        <a
          href="https://github.com/wagtail/madewithwagtail-static/issues/new?template=site-submission.yml"
        >
          site submission form on GitHub
        </a
        >. Our automated pipeline will verify the site, take a screenshot, and open a pull request
        for review — you can follow along on the issue.
      </p>
    </div>
  </div>
</BaseLayout>

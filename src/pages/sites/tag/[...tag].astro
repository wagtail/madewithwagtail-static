---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import SiteCard from '../../../components/SiteCard.astro';
import { withBase } from '../../../helpers.ts';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const allSites = await getCollection('sites');
  const allDevelopers = await getCollection('developers');

  const tagSet = new Set<string>();
  for (const site of allSites) {
    for (const tag of site.data.tags) {
      tagSet.add(tag.toLowerCase());
    }
  }

  return Array.from(tagSet).map((tag) => ({
    params: { tag },
  }));
}) satisfies GetStaticPaths;

const tag = Astro.params.tag as string;

const allSites = await getCollection('sites');
const allDevelopers = await getCollection('developers');
const devMap = new Map(allDevelopers.map((d) => [d.id, d]));

const filteredSites = allSites
  .filter((site) => site.data.tags.some((t: string) => t.toLowerCase() === tag))
  // Sort by the site slug (last ID segment) so the listing is deterministic
  // regardless of filesystem enumeration order.
  .sort(
    (a, b) =>
      (a.id.split('/').at(-1) ?? a.id).localeCompare(b.id.split('/').at(-1) ?? b.id) ||
      a.id.localeCompare(b.id),
  );
const displayName =
  filteredSites.length > 0
    ? (filteredSites[0].data.tags.find((t: string) => t.toLowerCase() === tag) ?? tag)
    : tag;

function getCooperator(cooperatorSlug: string) {
  return devMap.get(cooperatorSlug);
}
---

<BaseLayout title={`Sites tagged "${displayName}"`}>
  <div class="content-width">
    <div class="banner">
      <h1>Sites tagged with &ldquo;{displayName}&rdquo;</h1>
      <a href={withBase('/')}>Show all sites</a>
    </div>

    <div class="grid grid-stack site-listing">
      {filteredSites.map((site) => {
        const dev = devMap.get(site.id.split('/')[0]);
        return (
          <SiteCard
            title={site.data.title}
            url={withBase(`/developers/${site.id}/`)}
            developerName={dev?.data.title ?? 'A Wagtail developer'}
            developerUrl={withBase(dev ? `/developers/${dev.id}/` : '/developers/')}
            screenshotUrl={site.data.site_screenshot_url ? withBase(site.data.site_screenshot_url) : null}
            siteUrl={site.data.site_url}
            inCooperationWith={site.data.in_cooperation_with_slug
              ? getCooperator(site.data.in_cooperation_with_slug)?.data.title ?? null
              : null
            }
            inCooperationWithUrl={
              site.data.in_cooperation_with_slug
                ? withBase(
                    getCooperator(site.data.in_cooperation_with_slug)
                      ? `/developers/${site.data.in_cooperation_with_slug}/`
                      : '/developers/',
                  )
              : null
            }
          />
        );
      })}
    </div>
  </div>
</BaseLayout>

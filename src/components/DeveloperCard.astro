---
import { existsSync } from 'node:fs';
import { withBase } from '../helpers.ts';

interface Props {
  title: string;
  url: string;
  // Developer entry ID: the logo lives at public/images/<id>.max-120x120.webp
  // when the developer has one.
  id: string;
  location: string | null;
  sitesCount: number;
}

const { title, url, id, location, sitesCount } = Astro.props;
const logoFile = `images/${id}.max-120x120.webp`;
const hasLogo = existsSync(`./public/${logoFile}`);
---

<div class="one-half--medium one-third--large company-listing__column">
  <a class="company-listing link-ghost" href={url}>
    <div class="media__image">
      {hasLogo ? (
        <img src={withBase(`/${logoFile}`)} alt={title} loading="lazy" width="80" height="80" />
      ) : (
        <div class="company__placeholder"></div>
      )}
    </div>
    <div class="media__body">
      <h4 class="company-listing__title">{title}</h4>
      {location && (
        <p class="company-listing__location truncate">{location}</p>
      )}
      {sitesCount > 0 && (
        <p class="company-listing__site-count">
          {sitesCount} site{sitesCount !== 1 ? 's' : ''}
        </p>
      )}
    </div>
  </a>
</div>
